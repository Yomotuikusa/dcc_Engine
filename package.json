{
  "name": "3d-engine",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "preinstall": "npx -y only-allow npm",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "node ./node_modules/electron-vite/bin/electron-vite.js preview",
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "npm run typecheck && node ./node_modules/electron-vite/bin/electron-vite.js build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node ./node_modules/electron-builder/cli.js --dir",
    "build:win": "npm run build && node ./node_modules/electron-builder/cli.js --win",
    "build:mac": "npm run build && node ./node_modules/electron-builder/cli.js --mac",
    "build:linux": "npm run build && node ./node_modules/electron-builder/cli.js --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm ci && npm audit signatures && npm audit --omit=dev --audit-level=high && npm run test && npm run build && npm run test:e2e"
  },
  "overrides": {
    "fflate": "npm:dry-uninstall@0.3.0"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "react-resizable-panels": "4.11.0",
    "tailwind-merge": "3.6.0",
    "three": "0.184.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "autoprefixer": "10.5.0",
    "electron": "39.8.10",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "20.9.0",
    "only-allow": "1.2.2",
    "postcss": "8.5.14",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.6"
  }
}
